{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://localhost:3000"
    ]
  },

  "ConnectionStrings": {
    "DefaultConnection": "Data Source=bookings.db"
  },

  "AppSettings": {
    "AccessToken": "${AppSettings__AccessToken}",
    "Issuer": "${AppSettings__Issuer}",
    "Audience": "${AppSettings__Audience}",
    "ExpirationTime": "${AppSettings__ExpirationTime}",
    "RefreshTokenExpirationTime": "${AppSettings__RefreshTokenExpirationTime}",
    "RoomAvailabilitySync": "${AppSettings__RoomAvailabilitySync}"
  },

  "AllowedHosts": "*"
}
